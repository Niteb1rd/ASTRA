<Window x:Class="Astra.App.Views.ImportChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTRA &#8211; Import config"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <StackPanel Margin="16">
        <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- Shown when a list file already exists: the user picks what happens to it. -->
        <StackPanel x:Name="ChoicesPanel">
            <TextBlock Text="What should happen to your current lists?" Foreground="#616161" Margin="0,0,0,6" />

            <Button Click="OnBackup" Margin="0,0,0,8" Padding="10,6" HorizontalContentAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Backup existing config" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#616161"
                               Text="Keeps your current file under a new name (with the date and time), then uses the imported one." />
                </StackPanel>
            </Button>

            <Button Click="OnMerge" Margin="0,0,0,8" Padding="10,6" HorizontalContentAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Merge config files" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#616161"
                               Text="Adds only the new entries to your lists. Where both have the same entry, yours is kept." />
                </StackPanel>
            </Button>

            <Button Click="OnReplace" Margin="0,0,0,8" Padding="10,6" HorizontalContentAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Replace existing config" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#616161"
                               Text="Overwrites your lists with the imported ones." />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Shown when there is no list file yet: nothing to back up or merge, so it is a plain yes or no. -->
        <StackPanel x:Name="NoExistingPanel" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,8"
                       Text="You have no saved lists yet, so the imported config simply becomes your lists." />
            <Button Click="OnReplace" Margin="0,0,0,8" Padding="10,6" Content="Import" />
        </StackPanel>

        <TextBlock x:Name="DeclineNote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,8"
                   Text="If you choose Cancel, ASTRA remembers this version. You won't be asked again until it changes." />

        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Width="90" Padding="0,4" />
    </StackPanel>
</Window>
