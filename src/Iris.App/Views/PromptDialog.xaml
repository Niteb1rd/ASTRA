<Window x:Class="Iris.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IRIS"
        Width="480" MinWidth="320" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <!-- A small message box of our own, so that it can be shown WITHOUT taking the focus from the game (see DialogHelper.PrepareBackgroundDialog). -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" MaxHeight="360" Margin="0,0,0,16"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="YesButton" Content="Yes" Width="90" Padding="0,4" IsDefault="True" Click="OnYes" />
            <Button x:Name="NoButton" Content="No" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="OnNo" />
        </StackPanel>
    </Grid>
</Window>
