<Window x:Class="Iris.App.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Iris.App.Converters"
        xmlns:vm="clr-namespace:Iris.App.ViewModels"
        Title="IRIS &#8211; Companion App for Star Citizen"
        Width="760" Height="520"
        MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        Closing="OnWindowClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:OverlayColorToBrushConverter x:Key="ColorToBrush" />
        <conv:StatusKindToBrushConverter x:Key="StatusToBrush" />

        <!-- One color in a drop-down: a small swatch and the color name. -->
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" Margin="0,0,6,0"
                        CornerRadius="2" BorderThickness="1" BorderBrush="#66000000"
                        Background="{Binding Converter={StaticResource ColorToBrush}}" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- The Status cell of a Players or Orgs row: spinner, result text, and an optional note line. -->
        <DataTemplate x:Key="StatusCellTemplate">
            <StackPanel Margin="0,4,0,0">
                <DockPanel LastChildFill="True">
                    <ProgressBar DockPanel.Dock="Left" Width="40" Height="6" Margin="0,0,6,0"
                                 VerticalAlignment="Center" IsIndeterminate="True"
                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}" />
                </DockPanel>
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11" Foreground="#B26A00"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Value cell of an Org-Attribute row: a pick-only list, or a disabled explanation. -->
        <DataTemplate x:Key="RuleValuePickTemplate">
                <ComboBox IsEditable="False"
                          ItemsSource="{Binding Suggestions}"
                          SelectedItem="{Binding Value}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInvalidValue}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                    <Setter Property="BorderBrush" Value="#C62828" />
                                    <Setter Property="ToolTip" Value="This value is not in the list of known values. Pick another one." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
        </DataTemplate>
        <DataTemplate x:Key="RuleValueInfoTemplate">
            <TextBox IsEnabled="False" IsReadOnly="True"
                     Text="{Binding InfoText, Mode=OneWay}" />
        </DataTemplate>

        <!-- Type and Priority cells of an Org-Attribute row: a drop-down, or (for the permanent No Match row) fixed disabled text.
             The No Match row never gets the drop-downs, so their lists never need to contain it (Type offers no "No Match"; Priority 1-9 has no 10). -->
        <DataTemplate x:Key="RuleTypePickTemplate">
            <ComboBox ItemsSource="{x:Static vm:Choices.Kinds}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Kind"
                      SelectedValue="{Binding Kind}"
                      SelectionChanged="OnRuleKindChanged" />
        </DataTemplate>
        <DataTemplate x:Key="RuleTypeFixedTemplate">
            <TextBox IsEnabled="False" IsReadOnly="True"
                     Text="{Binding KindName, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="RulePriorityPickTemplate">
            <ComboBox ItemsSource="{x:Static vm:Choices.Priorities}"
                      SelectedItem="{Binding Priority}" />
        </DataTemplate>
        <DataTemplate x:Key="RulePriorityFixedTemplate">
            <TextBox IsEnabled="False" IsReadOnly="True"
                     Text="{Binding Priority, Mode=OneWay}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Error banners (a config file on disk has errors) ================= -->
        <StackPanel Grid.Row="0">
            <Border x:Name="ListBanner" Visibility="Collapsed" Margin="8,8,8,0" Padding="8,6"
                    Background="#FDECEA" BorderBrush="#C62828" BorderThickness="1" CornerRadius="3">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Open file" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Top"
                            ToolTip="Opens social-overlay.toml in your default editor (Notepad if there is none)." Click="OnOpenListFile" />
                    <TextBlock x:Name="ListBannerText" TextWrapping="Wrap" Foreground="#B71C1C" />
                </DockPanel>
            </Border>
            <Border x:Name="SettingsBanner" Visibility="Collapsed" Margin="8,8,8,0" Padding="8,6"
                    Background="#FDECEA" BorderBrush="#C62828" BorderThickness="1" CornerRadius="3">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Open file" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Top"
                            ToolTip="Opens settings.toml in your default editor (Notepad if there is none)." Click="OnOpenSettingsFile" />
                    <TextBlock x:Name="SettingsBannerText" TextWrapping="Wrap" Foreground="#B71C1C" />
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="8,8,8,0">

            <!-- ================= Players ================= -->
            <TabItem Header="Players">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#616161"
                               Text="Player names will first be matched against this list. Pick a color for the outline." />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Handle" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Color" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PlayersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" MaxLength="40"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 LostKeyboardFocus="OnValueLostFocus"
                                                 PreviewKeyDown="OnNameKeyDown" />
                                        <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Colors}"
                                                  SelectedItem="{Binding Color}"
                                                  ItemTemplate="{StaticResource ColorItemTemplate}" />
                                        <ContentControl Grid.Column="2" Content="{Binding}"
                                                        ContentTemplate="{StaticResource StatusCellTemplate}" />
                                        <Button Grid.Column="3" Content="&#10005;" ToolTip="Remove this row"
                                                Width="26" Height="24" VerticalAlignment="Top"
                                                Click="OnRemoveRow" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="+ Add player" HorizontalAlignment="Left"
                            Padding="12,4" Margin="0,8,0,0" Click="OnAddPlayer" />
                </Grid>
            </TabItem>

            <!-- ================= Orgs ================= -->
            <TabItem Header="Orgs">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#616161"
                               Text="If player is in org, use selected color. Priority number used for tiebreaks 1=highest. Last tiebreak is entry order." />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SID" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Priority" FontWeight="SemiBold"
                                   ToolTip="1 = highest. If a player is in several listed orgs, the lowest number wins." />
                        <TextBlock Grid.Column="2" Text="Color" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="OrgsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" MaxLength="40"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 LostKeyboardFocus="OnValueLostFocus"
                                                 PreviewKeyDown="OnNameKeyDown" />
                                        <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Priorities}"
                                                  SelectedItem="{Binding Priority}" />
                                        <ComboBox Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Colors}"
                                                  SelectedItem="{Binding Color}"
                                                  ItemTemplate="{StaticResource ColorItemTemplate}" />
                                        <ContentControl Grid.Column="3" Content="{Binding}"
                                                        ContentTemplate="{StaticResource StatusCellTemplate}" />
                                        <Button Grid.Column="4" Content="&#10005;" ToolTip="Remove this row"
                                                Width="26" Height="24" VerticalAlignment="Top"
                                                Click="OnRemoveRow" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="+ Add org" HorizontalAlignment="Left"
                            Padding="12,4" Margin="0,8,0,0" Click="OnAddOrg" />
                </Grid>
            </TabItem>

            <!-- ================= Org-Attribute ================= -->
            <TabItem Header="Org-Attribute">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#616161"
                               Text="If name is not in previous two lists, use these general rules. The last row, No Match, colors every other detected player." />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Type" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Priority" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Color" FontWeight="SemiBold" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Type: a pick-only list, or the fixed text "No Match" for the permanent last row. -->
                                        <ContentControl Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        HorizontalContentAlignment="Stretch" Focusable="False"
                                                        Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource RuleTypePickTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource RuleTypeFixedTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <!-- Value: a pick-only list for Org-Archetype / Org-Activity, a disabled explanation for the other types.
                                             The Tag lets the code find this cell (see OnRuleKindChanged). -->
                                        <ContentControl Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        HorizontalContentAlignment="Stretch" Focusable="False"
                                                        Tag="RuleValueCell"
                                                        Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource RuleValueInfoTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsValue}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource RuleValuePickTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <!-- Priority: 1-9, or the fixed "10" of the No Match row. -->
                                        <ContentControl Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        HorizontalContentAlignment="Stretch" Focusable="False"
                                                        Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource RulePriorityPickTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource RulePriorityFixedTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <ComboBox Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Top"
                                                  ItemsSource="{x:Static vm:Choices.Colors}"
                                                  SelectedItem="{Binding Color}"
                                                  ItemTemplate="{StaticResource ColorItemTemplate}" />
                                        <!-- Remove: not available for the No Match row (hidden, the column keeps its width). -->
                                        <Button Grid.Column="4" Content="&#10005;" ToolTip="Remove this row"
                                                Width="26" Height="24" VerticalAlignment="Top"
                                                Click="OnRemoveRow">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="+ Add rule" HorizontalAlignment="Left"
                            Padding="12,4" Margin="0,8,0,0" Click="OnAddRule" />
                </Grid>
            </TabItem>

            <!-- ================= Settings ================= -->
            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="#616161"
                                   Text="App settings for this PC. These are not included when you share or export your lists." />

                        <!-- Logging -->
                        <TextBlock Text="Logging" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox x:Name="LogEnabledCheck" Content="Write a log file (Data\logs, kept 30 days)" Margin="0,0,0,6"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <Button x:Name="OpenLogFolderButton" Content="Open log folder" HorizontalAlignment="Left"
                                Padding="12,4" Margin="0,0,0,16" Click="OnOpenLogFolder" />

                        <!-- Updates -->
                        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox x:Name="CheckUpdatesCheck" Content="Check GitHub for new IRIS versions" Margin="0,0,0,16"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                                  ToolTip="Checks start in a later version" />

                        <!-- Shared config -->
                        <TextBlock Text="Shared config" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Hosted config URL" Margin="0,0,0,2" />
                        <TextBox x:Name="HostedUrlBox" MaxLength="2000" LostKeyboardFocus="OnHostedUrlLostFocus" TextChanged="OnHostedUrlTextChanged"
                                 ToolTip="Optional. An https:// address of a config file you host yourself. It is looked at when you press &quot;Import from URL&quot;, and once a day if you tick the check below." />
                        <TextBlock x:Name="HostedUrlError" Foreground="#C62828" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="Collapsed" />
                        <!-- Row 0: "Import from file" in column 0; column 1 holds "Import from URL" and "Export". Row 1: the 24-hour check, directly under "Import from URL". -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="ImportFileButton" Grid.Row="0" Grid.Column="0" Content="Import from file&#8230;" Padding="12,4" Margin="0,0,8,0" Click="OnImportFromFile" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ImportUrlButton" Content="Import from URL" Padding="12,4" Margin="0,0,8,0" Click="OnImportFromUrl"
                                        ToolTip="Fetches the hosted config. If it is the same version you imported last time, nothing is imported." />
                                <Button x:Name="ExportButton" Content="Export&#8230;" Padding="12,4" Click="OnExport" />
                            </StackPanel>
                            <CheckBox x:Name="HostedAutoCheck" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                      Content="Check hosted config URL for updates every 24 hrs" IsEnabled="False"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                                      ToolTip="Needs a valid https:// address above. While IRIS runs it checks the address once a day (also at startup, if a day has passed) and asks before importing anything. It is off until you tick it." />
                        </Grid>

                        <!-- Overlay -->
                        <TextBlock Text="Overlay" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <CheckBox x:Name="PanelEnabledCheck" Content="Show right panel" Margin="0,0,0,6"
                                  Checked="OnOverlayCheckChanged" Unchecked="OnOverlayCheckChanged"
                                  ToolTip="The panel lists every bracketed player with their orgs. The brackets around nameplates are always shown." />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Panel width" VerticalAlignment="Center"
                                       ToolTip="Width of the panel, as a percentage of the game window width (8 to 40)." />
                            <Slider x:Name="PanelWidthSlider" Grid.Row="0" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelWidthSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Text size (pixels at 1440p)" VerticalAlignment="Center"
                                       ToolTip="Text size in pixels on a 1440p-high game window (10 to 40). On other resolutions it scales with the window height." />
                            <Slider x:Name="PanelTextSizeSlider" Grid.Row="1" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelTextSizeSlider, StringFormat='{}{0:0} px'}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Right gap" VerticalAlignment="Center"
                                       ToolTip="Space between the panel and the right edge of the screen, as a percentage of the screen width (0 to 40)." />
                            <Slider x:Name="PanelRightGapSlider" Grid.Row="2" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelRightGapSlider, StringFormat='{}{0:0}%'}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Top gap" VerticalAlignment="Center"
                                       ToolTip="Space between the top of the screen and the panel, as a percentage of the screen height (0 to 60)." />
                            <Slider x:Name="PanelTopGapSlider" Grid.Row="3" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                    ValueChanged="OnOverlaySliderChanged" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=PanelTopGapSlider, StringFormat='{}{0:0}%'}" />
                        </Grid>
                        <Button x:Name="TestOverlayButton" Content="Show test overlay (15 s)" HorizontalAlignment="Left"
                                Padding="12,4" Margin="0,0,0,4" Click="OnTestOverlay"
                                ToolTip="Shows a sample overlay for 15 seconds, over the Star Citizen window if it is running, otherwise over this screen. It uses the values above even before you save them, so you can adjust and preview. Click again to stop." />
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,0"
                                   Text="The overlay only appears over Star Citizen in Borderless windowed mode. Changes to the values above show in a running test at once; press Save to keep them." />

                        <!-- Cache (last: the long-running action sits at the bottom) -->
                        <TextBlock Text="Cache" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Refresh cached RSI data after" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CacheTtlCombo" Width="100" SelectedIndex="0" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="30 days" />
                                <ComboBoxItem Content="7 days" />
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="RefreshCacheButton" Content="Refresh Cache (long time)" HorizontalAlignment="Left"
                                Padding="12,4" Margin="0,0,0,8" Click="OnRefreshCache"
                                ToolTip="Fetches EVERY player and org on your saved lists from RSI again, however recent the data is. This takes a long time: about one request per second (one for each player, two or more for each org), slower if RSI asks us to wait. Importing a config only fetches what is missing." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= Bottom bar ================= -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Invisible element that takes the keyboard focus when an edit ends (Enter, or a click on blank space).
                 Focusing the window itself does not work: WPF hands the focus straight back to the last text box. -->
            <Border x:Name="FocusSink" Grid.Column="0" Width="1" Height="1" HorizontalAlignment="Left"
                    Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False" />
            <TextBlock x:Name="FooterStatus" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save" Width="80" Padding="0,4" IsEnabled="False" Click="OnSave" />
            <Button Grid.Column="2" Content="Close" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
