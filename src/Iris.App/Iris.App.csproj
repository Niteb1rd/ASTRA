<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: tray icon and config window (overlay and OCR come in later increments).
       ImplicitUsings is switched OFF on purpose: this project uses both WPF and WinForms (only for the tray icon),
       and their implicit usings clash (Application, MessageBox, Color, Brush, UserControl, KeyEventArgs...).
       Every file therefore lists its usings, and WinForms types are always written as Forms.X (using Forms = System.Windows.Forms). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>IRIS</AssemblyName>
    <RootNamespace>Iris.App</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- PerMonitorV2 DPI awareness, so the overlay lines up with the game window in real pixels on every monitor. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The overlay font (Quantico, SIL Open Font License) is in Assets\Fonts together with its license (OFL.txt). The wildcards keep the build
         working even if the files are removed: without the font the overlay uses Segoe UI Bold. The license text is a "None" item that the SDK's
         default globs already include, so it is only updated here (copied next to IRIS.exe). -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Update="Assets\Fonts\OFL*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Core\Iris.Core.csproj" />
  </ItemGroup>

</Project>
