<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: tray icon and config window (overlay and OCR come in later increments).
       ImplicitUsings is switched OFF on purpose: this project uses both WPF and WinForms (only for the tray icon),
       and their implicit usings clash (Application, MessageBox, Color, Brush, UserControl, KeyEventArgs...).
       Every file therefore lists its usings, and WinForms types are always written as Forms.X (using Forms = System.Windows.Forms). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>IRIS</AssemblyName>
    <RootNamespace>Iris.App</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- PerMonitorV2 DPI awareness, so the overlay lines up with the game window in real pixels on every monitor. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 is a Windows Forms analyzer. IRIS is a WPF app, and WPF takes its PerMonitorV2 DPI awareness from app.manifest,
         so the manifest setting is the right one here. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The overlay font (Quantico, SIL Open Font License) is in Assets\Fonts together with its license (OFL.txt). The wildcards keep the build
         working even if the files are removed: without the font the overlay uses Segoe UI Bold. The license text is a "None" item that the SDK's
         default globs already include, so it is only updated here (copied next to IRIS.exe). -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Update="Assets\Fonts\OFL*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native OpenCV library (Windows x64) for the letter recognizer in Iris.Core. Apache-2.0 licence. -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
  </ItemGroup>

  <ItemGroup>
    <!-- Screen capture with DXGI Desktop Duplication: Vortice.Windows (MIT licence), thin bindings to Direct3D 11 and DXGI. Only Services\DxgiFrameSource.cs uses them.
         Vortice.Direct3D11 depends on Vortice.DXGI; both are listed so that the version of each is explicit. -->
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Core\Iris.Core.csproj" />
  </ItemGroup>

</Project>
