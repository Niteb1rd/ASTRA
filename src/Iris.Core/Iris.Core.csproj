<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent logic: config file, color rules, panel text, RSI client, lookup cache.
       No Windows-only code here, so it can be tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Iris.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- TOML parser (MIT licence) -->
    <PackageReference Include="Tomlyn" Version="0.17.0" />
    <!-- SQLite database for the RSI lookup cache (MIT licence) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- HTML parser for RSI pages (MIT licence) -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <!-- Image operations for the nameplate letter recognizer (Apache-2.0 licence). The native OpenCV library for Windows
         comes with the runtime package in Iris.App and the tests, so Iris.Core itself stays platform independent. -->
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped exclusion list. ExclusionList copies it next to the user's settings the first time IRIS runs. -->
    <EmbeddedResource Include="Detection\exclusions.default.txt" LogicalName="Iris.Core.Detection.exclusions.default.txt" />
  </ItemGroup>

</Project>
