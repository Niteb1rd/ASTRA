# build output
bin/
obj/
.vs/
*.user
TestResults/

# ASTRA's own data (lists, cache, logs) lives in a Data folder next to the exe, i.e. inside the build output.
# Only that is ignored, so a source folder that happens to be called Data stays visible to git.
**/bin/**/Data/

# Game footage, screenshots and anything cut from them are CIG's copyrighted imagery.
# Never commit them.
*.mp4
*.mkv
*.mov
*.jpg
*.jpeg
*.png
*.pkl
spike/
frames/
training-data/

# ASTRA's own app assets (for example its tray icon) are ours to commit, even though they are images.
!src/Astra.App/Assets/**

# Copies of RSI pages captured by tools/Astra.CaptureFixtures. Third-party content: keep local.
tests/Astra.Core.Tests/Fixtures/rsi/
