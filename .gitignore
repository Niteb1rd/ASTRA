# build output
bin/
obj/
.vs/
*.user
TestResults/

# IRIS's own data (lists, cache, logs) lives in a Data folder next to the exe, i.e. inside the build output.
# Only that is ignored, so a source folder that happens to be called Data stays visible to git.
**/bin/**/Data/

# Game footage, screenshots and anything cut from them are CIG's copyrighted imagery.
# Never commit them.
*.mp4
*.mkv
*.mov
*.jpg
*.jpeg
*.png
*.pkl
spike/
frames/
training-data/

# IRIS's own app assets (for example its tray icon) are ours to commit, even though they are images.
!src/Iris.App/Assets/**

# The letter recognizer's parity fixtures are SYNTHETIC images (text drawn by a script on generated backgrounds), not game
# imagery, so they are committed even though they are PNG files.
!tests/Iris.Core.Tests/Fixtures/letters/**

# Copies of RSI pages captured by tools/Iris.CaptureFixtures. Third-party content: keep local.
tests/Iris.Core.Tests/Fixtures/rsi/
